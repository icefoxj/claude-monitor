# M5Stack Tab5: ESP32-P4, 16 MB flash, 32 MB PSRAM. The PSRAM settings are
# what M5GFX requires for the MIPI-DSI panel (it refuses to start below
# 200 MHz) and follow M5Stack's own Tab5 projects; 200 MHz PSRAM is behind
# the experimental-features switch in ESP-IDF 5.5.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The themes' fonts take 1.8 MB: a 4 MB app partition instead of the
# 1.5 MB of the single-app-large table (nvs stays at 0x9000, so a stored
# calibration survives the change)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MONITOR_ANIME_THEME=y
CONFIG_MONITOR_LCARS_THEME=y
CONFIG_MONITOR_GALACTIC_THEME=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FREERTOS_HZ=1000
# app_main draws everything (tiles, inspector, screensaver) through M5GFX:
# the 3.5 KB default overflowed the moment the screensaver handed the
# screen back ("Stack protection fault"), and M5GFX copies a whole smooth-
# font glyph onto the stack (alloca), 28 KB for the anime theme's 192 px
# kanji, which overflowed 16 KB at boot
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
